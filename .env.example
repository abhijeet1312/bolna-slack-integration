# --- Required ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXXXX

# --- Recommended (security) ---
# Random shared secret. Bolna will call ?token=<this> or send X-Webhook-Token header.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Comma-separated list of allowed source IPs. Bolna sends from 13.203.39.153.
# Set empty to disable.
ALLOWED_IPS=13.203.39.153

# Set to true if running behind an LB/proxy that sets X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# --- Optional ---
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
WEB_CONCURRENCY=2

REDIS_URL=redis://redis:6379/0
DEDUPE_TTL_SECONDS=86400

SLACK_REQUEST_TIMEOUT=10.0
SLACK_MAX_RETRIES=3

RATE_LIMIT_PER_MINUTE=120
